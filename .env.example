# Backend Environment Configuration
# Copy to .env and fill in your production values

# Application
NODE_ENV=production
PORT=3000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=vts
DB_PASSWORD=vts
DB_NAME=vts
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_SSL=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Secrets - CHANGE THESE IN PRODUCTION!
JWT_ACCESS_SECRET=your_super_secure_access_secret_here
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_here
JWT_REFRESH_TTL=30d

# OTP
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Providers
SMS_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console

# Merchant
MERCHANT_LOGO_DIR=uploads/merchant-logos